# Optional local service credentials. Extension Settings can supply keys instead.
# Keys entered in Settings are session-only unless you explicitly consent to remember them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional local bridge NVIDIA key. Shared fallback deployments use a server secret instead.
NVIDIA_API_KEY=
# Public service origin only; set in the shell when running npm run build.
# The build never reads API keys or loads this .env automatically.
HOSTED_FALLBACK_URL=
# Optional. Leave empty to use the generated .local/bridge-token.txt token.
BRIDGE_TOKEN=
