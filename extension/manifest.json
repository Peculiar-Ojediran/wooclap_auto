{
  "manifest_version": 3,
  "name": "Wooclap Auto",
  "description": "Detect Wooclap questions, review AI suggestions, and optionally submit answers through a local AI service.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://wooclap.com/*", "https://*.wooclap.com/*", "http://127.0.0.1:4318/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Wooclap Auto" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://wooclap.com/*", "https://*.wooclap.com/*", "http://127.0.0.1:4318/practice*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:4318; img-src 'self' data:"
  }
}
