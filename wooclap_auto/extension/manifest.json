{
  "manifest_version": 3,
  "name": "Wooclap Auto",
  "description": "Answer Wooclap with NVIDIA DeepSeek, OpenAI, or Claude. Supports a hosted default and your own API keys.",
  "version": "0.3.0",
  "minimum_chrome_version": "118",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://wooclap.com/*",
    "https://*.wooclap.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://integrate.api.nvidia.com/*",
    "http://127.0.0.1:4318/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wooclap Auto"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://wooclap.com/*",
        "https://*.wooclap.com/*",
        "http://127.0.0.1:4318/practice*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.openai.com https://api.anthropic.com https://integrate.api.nvidia.com http://127.0.0.1:4318; img-src 'self' data:"
  }
}
